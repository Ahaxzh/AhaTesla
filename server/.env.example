# AhaTesla server 环境变量模板。复制为 .env 后按实际填写（.env 已被 gitignore）。
#   cp server/.env.example server/.env
#
# TeslaMate 只读桥接（deploy/bridge-compose.yml 暴露在 127.0.0.1:15432）。
DB_URL=postgres://teslamate:CHANGE_ME@127.0.0.1:15432/teslamate

# Mosquitto MQTT 桥接（127.0.0.1:11883）。
MQTT_URL=mqtt://127.0.0.1:11883

# HTTP 监听端口（默认 18500）。
PORT=18500
