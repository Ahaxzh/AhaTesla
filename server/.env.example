# AhaTesla server 环境变量模板。复制为 .env 后按实际填写（.env 已被 gitignore）。
#   cp server/.env.example server/.env
#
# TeslaMate 只读桥接（deploy/bridge-compose.yml 暴露在 127.0.0.1:15432）。
DB_URL=postgres://teslamate:CHANGE_ME@127.0.0.1:15432/teslamate

# Mosquitto MQTT 桥接（127.0.0.1:11883）。
MQTT_URL=mqtt://127.0.0.1:11883

# HTTP 监听端口（默认 18500）。
PORT=18500

# 监听地址：默认 127.0.0.1（裸机/systemd 安全默认；Docker/compose 内已显式
# 设置 HOST=0.0.0.0 以便端口映射 —— 宿主侧仍只绑 127.0.0.1）。
#HOST=127.0.0.1

# 信任反代的 X-Forwarded-For（登录限速按真实客户端 IP 分桶）。仅当 AhaTesla
# 始终部署在自有的 HTTPS 反代（如 NPM）之后才开启；直连暴露时绝不开启
# （该头可伪造）。默认 0。
#TRUST_PROXY=0

# 慢查询观测：超过该毫秒数的 SQL 打一行到 stdout（默认 2000，0 关闭逻辑见 db.mjs）。
#AHA_SLOW_QUERY_MS=2000
