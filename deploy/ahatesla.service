[Unit]
Description=AhaTesla - Tesla trip/cost assistant web + worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ahaxzh
Group=ahaxzh
WorkingDirectory=/home/ahaxzh/Projects/GitHub/AhaTesla/server
ExecStart=/bin/bash -lc 'exec node --env-file=.env src/index.mjs'
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=18500
# node 经 bash -l 加载 nvm,default 别名解析 → 永远跟随 nvm 默认版本,升级不再断
# process env 优先于 .env（Node --env-file 不覆盖已存在的环境变量），故此处 Environment= 仍可覆盖 .env：
# Environment=DB_URL=postgres://teslamate@127.0.0.1:15432/teslamate
# Environment=MQTT_URL=mqtt://127.0.0.1:11883

# 加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ahaxzh/Projects/GitHub/AhaTesla/server/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
