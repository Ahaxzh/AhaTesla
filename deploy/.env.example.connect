# ===== connect 版环境变量示例（connect-compose.yml 用，写入 server/.env）=====
# 桥接容器已把 TeslaMate 的 5432/1883 转发到宿主 127.0.0.1:15432/11883

# 只读账号连接串（在 TeslaMate 库执行 deploy/SQL/create-ro-user.sql 创建）
DB_URL=postgres://ahatesla_ro:PASSWORD@host.docker.internal:15432/teslamate

# MQTT 可选增强（桥接后本机可达）
MQTT_URL=mqtt://host.docker.internal:11883

PORT=18500
AHA_DATA_DIR=/data

# JWT 密钥（openssl rand -hex 32；不设则首启自动生成落 /data）
# SECRET_KEY=
