# ===== connect 版环境变量（connect-compose.yml 用）=====
# 复制为 deploy/.env。通常一行都不用改 —— 推荐把连接配置全部交给 /setup 向导
# （向导会探测你的 teslamate 库、自动创建只读账号、四级校验）。
#
# 以下仅在「跨机器接入」或「跳过向导直连」时才需要取消注释填写：

# 时区（默认即可）
#TZ=Asia/Shanghai

# 跨机器：直连对端 TeslaMate 库（对端需允许本机访问）
# DB_URL=postgres://ahatesla_ro:PASSWORD@192.168.1.10:5432/teslamate
# MQTT_URL=mqtt://192.168.1.10:1883

# 本机已有只读账号、跳过向导建号步骤时：
# DB_URL=postgres://ahatesla_ro:PASSWORD@database:5432/teslamate
#   （同网直连时主机名用你的 teslamate 服务名/容器名：database、TeslaMateDB 或 teslamate-database-1）
