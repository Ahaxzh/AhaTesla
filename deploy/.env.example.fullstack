# ===== 全栈版环境变量（fullstack-compose.yml 用）=====
# 复制为 deploy/.env，只需填下面 2 个密钥，其余全有默认值。
# 生成命令可直接复制执行（在本文件目录）：
#   echo "TM_DB_PASSWORD=$(openssl rand -hex 16)"
#   echo "TM_ENCRYPTION_KEY=$(openssl rand -base64 32)"

# TeslaMate 数据库密码（teslamate 超级用户与 ahatesla_ro 只读账号共用，简化首发体验）
TM_DB_PASSWORD=change-me-openssl-rand-hex-16

# TeslaMate 车辆 API 加密密钥（TeslaMate 官方要求的 ENCRYPTION_KEY）
TM_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# 时区（默认即可）
#TZ=Asia/Shanghai
